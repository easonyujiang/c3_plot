#!/usr/bin/env bash
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_dir"
python3 -m venv .venv
.venv/bin/python -m pip install uv
.venv/bin/uv sync --locked --inexact
npm --prefix frontend ci
npm --prefix frontend run build
echo 'Ready. Run ./c3 --open'
